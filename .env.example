# --- Core ---
TZ=Asia/Kolkata
PORT=3001

# Teams: channel > ... > Workflows > "Post to a channel when a webhook request is received" > copy URL
TEAMS_WEBHOOK_URL=

# Secret used by Uptime Kuma when calling http://watchdog:3001/hooks/kuma?token=...
HOOK_TOKEN=replace-with-long-random-string

# Dashboard login (basic auth)
DASH_USER=nuform
DASH_PASS=replace-me

# Public URL of the dashboard (used for the "Open dashboard" button in Teams cards)
DASHBOARD_URL=http://localhost:3001

# --- Daily checks ---
CHECK_CRON=0 9 * * *
SSL_WARN_DAYS=14
DOMAIN_WARN_DAYS=30
